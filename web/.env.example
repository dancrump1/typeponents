# Unlocks license-gated components (currently Great UI) in /library.
# Copy to .env.local and set a password before sharing with designers.
GATED_LIBRARY_PASSWORD=

# Broker for site rebuilds after a designer imports a component.
# Start it with `docker compose up -d` from the web folder.
RABBITMQ_URL=amqp://127.0.0.1:5672
